generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  MANAGER
  SALE
  RECEPTIONIST
}

enum PropertyType {
  HOTEL
  HOMESTAY
  VILLA
  RESORT
}

enum RoomStatus {
  VACANT
  BOOKED
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  HOLD
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum BookingSource {
  DIRECT
  PHONE
  WALK_IN
  BOOKING_COM
  AIRBNB
  AGODA
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOMO
  VNPAY
  ZALOPAY
  CARD
}

enum PaymentType {
  DEPOSIT
  FULL_PAYMENT
  EXTRA_CHARGE
  REFUND
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum NotificationType {
  NEW_BOOKING
  CHECKIN
  CHECKOUT
  CANCELLED
  PAYMENT_REMINDER
}

// ─── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(uuid())
  propertyId   String?
  fullName     String
  email        String    @unique
  phone        String?
  role         Role      @default(RECEPTIONIST)
  avatarUrl    String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  ownedProperties Property[]   @relation("PropertyOwner")
  bookingsCreated Booking[]    @relation("BookingCreator")
  paymentsCreated Payment[]    @relation("PaymentCreator")
  notifications   Notification[]

  @@map("users")
}

model Property {
  id          String       @id @default(uuid())
  name        String
  address     String
  city        String       @default("Ha Long")
  phone       String?
  email       String?
  type        PropertyType @default(HOMESTAY)
  description String?
  logoUrl     String?
  ownerId     String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner User   @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  users User[]
  rooms Room[]

  @@map("properties")
}

model RoomType {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  basePrice   Decimal @default(0) @db.Decimal(12, 0)
  maxCapacity Int     @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]

  @@map("room_types")
}

model Amenity {
  id       String @id @default(uuid())
  name     String @unique
  icon     String?
  category String?
  createdAt DateTime @default(now())

  rooms RoomAmenity[]

  @@map("amenities")
}

model RoomAmenity {
  roomId    String
  amenityId String

  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
  @@map("room_amenities")
}

model Room {
  id            String     @id @default(uuid())
  propertyId    String
  roomTypeId    String
  name          String
  floor         Int        @default(1)
  capacity      Int        @default(2)
  areaSqm       Float?
  pricePerNight Decimal    @db.Decimal(12, 0)
  weekendPrice  Decimal?   @db.Decimal(12, 0)
  status        RoomStatus @default(VACANT)
  description   String?
  notes         String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  property  Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomType  RoomType      @relation(fields: [roomTypeId], references: [id])
  images    RoomImage[]
  amenities RoomAmenity[]
  bookings  Booking[]

  @@map("rooms")
}

model RoomImage {
  id        String  @id @default(uuid())
  roomId    String
  url       String
  publicId  String
  isCover   Boolean @default(false)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("room_images")
}

model Customer {
  id            String   @id @default(uuid())
  fullName      String
  phone         String   @unique
  email         String?
  idCard        String?
  dateOfBirth   DateTime? @db.Date
  nationality   String?  @default("Viet Nam")
  address       String?
  isVip         Boolean  @default(false)
  vipSince      DateTime? @db.Date
  totalBookings Int      @default(0)
  totalSpent    Decimal  @default(0) @db.Decimal(14, 0)
  notes         String?
  tags          String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]

  @@map("customers")
}

model Booking {
  id             String        @id @default(uuid())
  bookingCode    String        @unique
  roomId         String
  customerId     String
  createdBy      String
  checkinDate    DateTime      @db.Date
  checkoutDate   DateTime      @db.Date
  actualCheckin  DateTime?
  actualCheckout DateTime?
  guestCount     Int           @default(1)
  status         BookingStatus @default(HOLD)
  totalPrice     Decimal       @default(0) @db.Decimal(12, 0)
  extraCharges   Decimal       @default(0) @db.Decimal(12, 0)
  discount       Decimal       @default(0) @db.Decimal(12, 0)
  deposit        Decimal       @default(0) @db.Decimal(12, 0)
  source         BookingSource @default(DIRECT)
  notes          String?
  cancelReason   String?
  holdExpireAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  room          Room           @relation(fields: [roomId], references: [id])
  customer      Customer       @relation(fields: [customerId], references: [id])
  creator       User           @relation("BookingCreator", fields: [createdBy], references: [id])
  payments      Payment[]
  notifications Notification[]

  @@map("bookings")
}

model Payment {
  id             String        @id @default(uuid())
  bookingId      String
  amount         Decimal       @db.Decimal(12, 0)
  method         PaymentMethod @default(CASH)
  type           PaymentType   @default(FULL_PAYMENT)
  status         PaymentStatus @default(COMPLETED)
  transactionRef String?
  note           String?
  createdBy      String
  createdAt      DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  creator User    @relation("PaymentCreator", fields: [createdBy], references: [id])

  @@map("payments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  bookingId String?
  title     String
  body      String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@map("notifications")
}
