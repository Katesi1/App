<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Halong24h</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Halong24h</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.492063080427-cvghpnt7mi6htniimvq5a9ntb768fbe5</string>
				</array>
			</dict>
		</array>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>GIDClientID</key>
		<string>492063080427-cvghpnt7mi6htniimvq5a9ntb768fbe5.apps.googleusercontent.com</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>FlutterSceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<!-- App chạy portrait-only (kiểu mobile). Opt-out iPad multitasking
		     (Slide Over/Split View) để được phép chỉ Portrait — nếu không Apple
		     bắt buộc khai báo đủ 4 hướng cho iPad. -->
		<key>UIRequiresFullScreen</key>
		<true/>
		<!-- ── Permissions cho image_picker ──────────────────────────────
	     Verify flow cần camera (chụp CCCD + selfie) và thư viện ảnh
	     (option upload ảnh sẵn nếu camera permission denied).
	     iOS sẽ crash app nếu mở camera mà thiếu NSCameraUsageDescription. -->
		<key>NSCameraUsageDescription</key>
		<string>Halong24h cần truy cập camera để bạn chụp CCCD và selfie xác minh danh tính chủ nhà.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Halong24h cần truy cập thư viện ảnh để bạn chọn ảnh CCCD/selfie có sẵn cho bước xác minh.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Halong24h cần quyền lưu ảnh (vd: ảnh QR thanh toán) vào thư viện ảnh của bạn.</string>
		<!-- App KHÔNG thu âm — camera scanner (CCCD/selfie) khởi tạo với
		     `enableAudio: false`. Tuy nhiên plugin `camera` ở một số iOS
		     version vẫn query AVAudioSession khi mở camera → thiếu key này
		     sẽ bị iOS crash app với privacy violation. -->
		<key>NSMicrophoneUsageDescription</key>
		<string>Halong24h không thu âm — chỉ dùng camera để quét CCCD và xác minh khuôn mặt.</string>
		<!-- ── Quyền vị trí cho map picker (chọn vị trí cơ sở khi tạo phòng) ──
		     Chỉ dùng khi app đang mở để lấy vị trí hiện tại ghim lên bản đồ. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Halong24h cần vị trí của bạn để ghim chính xác vị trí cơ sở (homestay/villa) lên bản đồ khi tạo phòng.</string>
		<!-- App chỉ dùng vị trí khi đang mở (when-in-use). Apple vẫn yêu cầu
		     purpose string cho API "Always" vì SDK bên thứ ba có tham chiếu tới
		     (ITMS-90683) — app không chạy nền theo dõi vị trí. -->
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Halong24h cần vị trí của bạn để ghim chính xác vị trí cơ sở (homestay/villa) lên bản đồ khi tạo phòng. App chỉ dùng vị trí khi bạn đang mở app, không theo dõi nền.</string>
		<!-- App only uses standard HTTPS + iOS keychain — no custom crypto.
		     Setting this to false skips App Store Connect's Export Compliance
		     prompt on every upload (would otherwise block TestFlight install
		     until manually answered). -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Schemes the app calls `canLaunchUrl` on. iOS 14+ blocks the check
		     (returns false) unless the scheme is declared here. http/https
		     work by default; tel/sms/mailto need explicit allow-list. -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>tel</string>
			<string>sms</string>
			<string>mailto</string>
		</array>
	</dict>
</plist>
